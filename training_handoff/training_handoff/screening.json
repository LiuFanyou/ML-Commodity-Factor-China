{
  "dataset_version": "CORE30_V1",
  "data_root": "data_research/core30_v1",
  "development_start": "2018-01-01",
  "development_end": "2024-12-31",
  "sealed_start": "2025-01-01",
  "sealed_end": "2025-12-31",
  "walk_forward": {
    "train_years": 3,
    "first_oos_year": 2018,
    "last_development_oos_year": 2024
  },
  "labels": {
    "primary_horizon": 5,
    "horizons": [1, 5, 20],
    "signal_time": "trade_date_close",
    "execution_time": "next_trading_day_open",
    "daily_return_column": "primary_return",
    "multi_day_convention": "compound_next_h_daily_open_to_close_returns_with_daily_reentry"
  },
  "lookbacks": {
    "short": [5, 20],
    "trend": [20, 60, 120],
    "curve": [5, 20, 60],
    "risk": [20, 60, 120]
  },
  "curve": {
    "minimum_days_to_delisting": 10,
    "maximum_days_to_delisting": 365,
    "minimum_contracts_for_slope": 2,
    "minimum_contracts_for_curvature": 3,
    "price_column": "close",
    "slope_weight": "sqrt_open_interest"
  },
  "screening": {
    "minimum_cross_section_assets": 8,
    "minimum_factor_coverage": 0.35,
    "fdr_method": "benjamini_hochberg",
    "fdr_q": 0.10,
    "correlation_cluster_threshold": 0.85,
    "newey_west_lag_by_horizon": true,
    "two_way_cluster_inference": true,
    "quantile_groups": 5,
    "annualization_days": 252,
    "cost_bps_one_way": [1, 3, 5]
  },
  "features": {
    "mad_clip": 5.0,
    "missing_indicator_threshold": 0.01,
    "maximum_missing_rate": 0.65,
    "cross_sectional_standardization": true,
    "fold_train_only_scaling": true,
    "pre_registered_interactions": [
      ["tsmom_60", "carry"],
      ["momentum_quality_60", "carry"],
      ["tsmom_20", "oi_surprise_20"]
    ]
  },
  "sealed_test": {
    "must_have_freeze_manifest": true,
    "allow_overwrite": false,
    "result_file": "artifacts/sealed/sealed_2025_metrics.csv"
  }
}
